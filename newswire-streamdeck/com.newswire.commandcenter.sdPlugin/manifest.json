{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.newswire.commandcenter",
  "Name": "NewsWire Command Center",
  "Category": "NewsWire Command Center",
  "Description": "Free offline controls for the NewsWire Storm Command Center. Official NWS warning status and map controls.",
  "Author": "NewsWire",
  "Version": "0.7.3.0",
  "SDKVersion": 2,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "24"
  },
  "Icon": "imgs/plugin",
  "CategoryIcon": "imgs/category",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
