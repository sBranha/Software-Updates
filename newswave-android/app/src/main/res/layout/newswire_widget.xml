<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/newswire_widget_bg">
    <TextView android:id="@+id/widget_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NEWSWIRE  /  MY AREA" android:textColor="#84EAF4"
        android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/widget_location"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Your local area" android:textColor="#ADC8D7" android:layout_marginTop="6dp"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_weather"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Weather —" android:textColor="#F4FAFF"
        android:layout_marginTop="10dp" android:textSize="19sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_alert"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NWS alerts unchecked" android:textColor="#FFCD8A"
        android:layout_marginTop="6dp" android:textSize="12sp"
        android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_headline"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Headlines: open NewsWire" android:textColor="#D6E8F6"
        android:layout_marginTop="8dp" android:textSize="12sp"
        android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <TextView android:id="@+id/widget_checked"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Not checked"
            android:textColor="#93AEC3" android:textSize="10sp"/>
        <TextView android:id="@+id/widget_refresh"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="8dp" android:text="↻ REFRESH"
            android:textColor="#83E5EE" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>