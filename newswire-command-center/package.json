{
  "name": "newswire-command-center",
  "version": "0.8.1",
  "private": true,
  "description": "Free nationwide storm warning command center using official NWS alert data",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.js deck-bridge.test.cjs window-layout.test.cjs radar-tracking.test.cjs draw-loop.test.cjs communities-service.test.cjs offline-cities.test.cjs polygon-focus.test.cjs studio-map.test.cjs site-radar.test.cjs radar-data/level2-volume.test.cjs radar-data/scan-service.test.cjs velocity-couplet.test.cjs",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "package:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "net.newswire.commandcenter",
    "productName": "NewsWire Command Center",
    "copyright": "NewsWire",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "engine.js",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "deck-bridge.cjs",
      "window-layout.cjs",
      "desktop.css",
      "workspace-ui.js",
      "local.html",
      "warnings.html",
      "panels.css",
      "panels.js",
      "desktop-concept3.html",
      "concept3.css",
      "concept3-ui.js",
      "radar.js",
      "tracking-engine.js",
      "storm.html",
      "storm.css",
      "storm.js",
      "drawn-tracks.js",
      "radar-loop.js",
      "polygon-ui.js",
      "communities-service.cjs",
      "offline-cities.cjs",
      "data/census-places-2025.json",
      "map-views.js",
      "site-radar.js",
      "radar-data/level2-volume.cjs",
      "radar-data/scan-service.cjs",
      "rotation-tool.js",
      "velocity-couplet.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NewsWire-Command-Center-0.8.1-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "NewsWire-Command-Center-0.7.5-Mac-${arch}.${ext}",
      "category": "public.app-category.weather"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
