<Window x:Class="CameraAutoUpload.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Auto Upload" Width="1280" Height="920" MinWidth="980" MinHeight="700"
        Background="#05080C" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#05080C"/>
        <SolidColorBrush x:Key="Panel" Color="#10171F"/>
        <SolidColorBrush x:Key="Panel2" Color="#17202A"/>
        <SolidColorBrush x:Key="Line" Color="#2A3642"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA6B2"/>
        <SolidColorBrush x:Key="Blue" Color="#2196F3"/>
        <SolidColorBrush x:Key="Green" Color="#37CE6C"/>
        <SolidColorBrush x:Key="Red" Color="#EF5350"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC107"/>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26323D"/>
            <Setter Property="BorderBrush" Value="#43515F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RoundButton}"/>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#121A22"/><Setter Property="BorderBrush" Value="#34424F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="7"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#17202A"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#10171F"/><Setter Property="BorderBrush" Value="#2A3642"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="4,7"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Background" Value="#090E13"/><Setter Property="BorderBrush" Value="#1E2933"/><Setter Property="Height" Value="66"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="MinWidth" Value="96"/><Setter Property="Height" Value="54"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="MinWidth" Value="88"/><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="#18212B"/><Setter Property="Padding" Value="8,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

        <!-- Android-style top app bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" Background="#121A22" BorderBrush="#26323D" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
                <TextBlock Text="📷" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Camera Auto Upload" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
            <Button Grid.Column="2" Content="⚙" FontSize="20" Padding="0" Click="Settings_Click" ToolTip="Settings" Background="#121A22"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- HOME: same stacked Android-card structure -->
            <Grid x:Name="HomePage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <Border Width="250" Height="180" Background="#090D12" BorderBrush="#26323D" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center">
                                    <TextBlock Text="📷" FontSize="96" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="HomeCameraName" Text="Nikon Z8" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock x:Name="HomeCameraMode" Text="Direct Wi-Fi FTP" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                <TextBlock x:Name="HomeCameraStatus" Text="Waiting for camera" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Green}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" Margin="0,4,0,2">
                                    <Border Background="#17202A" CornerRadius="14" Margin="3" Padding="11"><StackPanel><TextBlock Text="Wi-Fi / Camera" Foreground="{StaticResource Green}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Ready / waiting" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Background="#17202A" CornerRadius="14" Margin="3" Padding="11"><StackPanel><TextBlock Text="Flickr / Internet" Foreground="{StaticResource Blue}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="HomeQueueStatus" Text="0 pending" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                                </UniformGrid>
                                <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="CHOOSE CAMERA" Background="{StaticResource Blue}" Click="ChooseCamera_Click"/>
                                    <Button Content="CAMERA SETUP" Background="#2E7D32" Click="CameraSetup_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#17351F" BorderBrush="#2D7D43" BorderThickness="1" CornerRadius="16" Padding="13" Margin="4,5">
                            <TextBlock x:Name="HomeLockStatus" Text="READY" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Connection status" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="ConnectionSummary" Text="Waiting for camera" Foreground="#C7D0D8" TextWrapping="Wrap" Margin="0,8,0,8" LineHeight="20"/>
                                <UniformGrid Columns="3">
                                    <Button Content="USB-C / TETHER" Background="{StaticResource Green}" Click="UsbTether_Click"/>
                                    <Button Content="WI-FI / FTP" Background="{StaticResource Blue}" Click="CameraSetup_Click"/>
                                    <Button Content="HOTSPOT" Background="#6A4C93" Click="Hotspot_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Editor automation" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="EditorAutomationText" Text="Open Editor, build the layout, then LOCK it for incoming camera photos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,8" LineHeight="20"/>
                                <Button Content="OPEN PHOTO EDITOR" Background="{StaticResource Blue}" HorizontalAlignment="Stretch" Click="Editor_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="Activity" FontWeight="Bold" FontSize="17"/><TextBox x:Name="ActivityLog" Height="125" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PHOTOS: Android-style 3-column gallery instead of desktop file list -->
            <Grid x:Name="PhotosPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="4,2,4,6">
                    <WrapPanel>
                        <Button Content="ALL" Click="PhotosAll_Click"/><Button Content="ORIGINALS" Click="PhotosOriginals_Click"/><Button Content="EDITED" Click="PhotosEdited_Click"/><Button Content="INBOUND" Click="PhotosInbound_Click"/>
                        <Button Content="REFRESH" Background="{StaticResource Blue}" Click="RefreshPhotos_Click"/><Button Content="OPEN FOLDER" Background="#2E7D32" Click="OpenPhotosFolder_Click"/>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="PhotosFolderText" Grid.Row="1" Text="Photos" Foreground="{StaticResource Muted}" Margin="8,2,8,8"/>
                <ListBox x:Name="PhotosList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" MouseDoubleClick="PhotosList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="tile" Width="230" Height="170" CornerRadius="12" BorderBrush="#2A3642" BorderThickness="2" Background="#10171F" ClipToBounds="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="#2196F3"/><Setter TargetName="tile" Property="BorderThickness" Value="4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Image Source="{Binding}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="6,4"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="10"/></Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- EDITOR: large canvas first, Photoshop-like bottom controls -->
            <Grid x:Name="EditorPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="62"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                    <Button Content="‹" FontSize="30" Padding="0" Background="#121A22" Click="Home_Click"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="Photo Editor" FontSize="21" FontWeight="Bold"/><TextBlock Text="Direct canvas editor" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    <Button Grid.Column="2" x:Name="LockLayoutButton" Content="LOCK" Background="#475462" Click="LockLayout_Click"/>
                    <Button Grid.Column="3" Content="SAVE" Background="#FF1428" Click="SaveLayout_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="EditorStatus" Text="Click the photo or a layer directly • drag • wheel/pinch • rotate • double-click for properties" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0" TextWrapping="Wrap"/>

                <Grid Grid.Row="2" Margin="2">
                    <Border Background="#070A0E" BorderBrush="#26323D" BorderThickness="1" CornerRadius="16" Padding="8" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
                                <Viewbox x:Name="EditorViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas x:Name="Artboard" Width="1080" Height="1350" Background="#111820" MouseDown="Artboard_MouseDown" MouseMove="Artboard_MouseMove" MouseUp="Artboard_MouseUp" MouseWheel="Artboard_MouseWheel" IsManipulationEnabled="True" ManipulationDelta="Artboard_ManipulationDelta"/>
                                </Viewbox>
                            </ScrollViewer>
                            <Border x:Name="LayersPanel" Visibility="Collapsed" Width="300" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#F20D131A" BorderBrush="#34424F" BorderThickness="1" CornerRadius="14" Margin="10" Padding="12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top"><TextBlock Text="LAYERS" FontWeight="Bold" FontSize="17"/><TextBlock Text="Photo is the bottom layer. Select any item to edit it." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/></StackPanel>
                                    <ListBox x:Name="LayerList" Background="#0F151C" Foreground="White" BorderBrush="#33414E" SelectionChanged="LayerList_SelectionChanged"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Button Style="{StaticResource ToolButton}" Content="📷&#x0a;PHOTO" Background="{StaticResource Blue}" Click="OpenPhoto_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="▣&#x0a;FRAME" Background="{StaticResource Green}" Click="AddImage_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="T&#x0a;TEXT" Background="#FF1428" Click="AddText_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="Aa&#x0a;NAME" Background="{StaticResource Blue}" Click="AddName_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="#&#x0a;NUMBER" Background="{StaticResource Blue}" Click="AddNumber_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="P&#x0a;POSITION" Background="{StaticResource Blue}" Click="AddPosition_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="★&#x0a;LOGO" Background="{StaticResource Green}" Click="AddImage_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="□&#x0a;SHAPE" Background="#6A4C93" Click="AddShape_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="◉&#x0a;COLOR" Background="#6A4C93" Click="Color_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="⚙&#x0a;PROPERTIES" Background="#4B5A7D" Click="Properties_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="▱&#x0a;LAYERS" Click="Layers_Click"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Button Style="{StaticResource ActionButton}" Content="↶&#x0a;UNDO" Click="Undo_Click"/><Button Style="{StaticResource ActionButton}" Content="↷&#x0a;REDO" Click="Redo_Click"/>
                        <Button Style="{StaticResource ActionButton}" Content="⛶&#x0a;FIT PHOTO" Click="FitPhoto_Click"/><Button Style="{StaticResource ActionButton}" Content="⌕&#x0a;FIT VIEW" Click="FitView_Click"/>
                        <Button Style="{StaticResource ActionButton}" Content="↑&#x0a;FRONT" Click="BringFront_Click"/><Button Style="{StaticResource ActionButton}" Content="↓&#x0a;BACK" Click="SendBack_Click"/>
                        <Button Style="{StaticResource ActionButton}" Content="⧉&#x0a;COPY" Click="Duplicate_Click"/><Button Style="{StaticResource ActionButton}" Content="⌫&#x0a;DELETE" Background="#B43A38" Click="Delete_Click"/>
                        <Button Style="{StaticResource ActionButton}" Content="✂&#x0a;CROP" Background="#8A6D00" Click="Crop_Click"/><Button Style="{StaticResource ActionButton}" Content="RESET&#x0a;CROP" Click="ResetCrop_Click"/>
                        <Button Style="{StaticResource ActionButton}" Content="#&#x0a;GRID" Click="Grid_Click"/><Button Style="{StaticResource ActionButton}" Content="⇩&#x0a;EXPORT" Background="#6A4C93" Click="Export_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- UPLOADS: card/progress layout like Android -->
            <Grid x:Name="UploadsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="●  Flickr" FontSize="22" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Windows account" Foreground="{StaticResource Green}" VerticalAlignment="Center"/></Grid>
                        <CheckBox x:Name="FlickrEnabledCheck" Content="Upload new photos to Flickr" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UPLOAD QUEUE" Foreground="{StaticResource Blue}" FontWeight="Bold"/><TextBlock x:Name="QueueCountText" Text="0 pending" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/><ProgressBar Height="12" Minimum="0" Maximum="100" Value="100" Foreground="{StaticResource Green}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Flickr connection" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="API Key"/><TextBox x:Name="FlickrApiKeyBox" TextChanged="SettingsChanged"/><TextBlock Text="API Secret"/><TextBox x:Name="FlickrApiSecretBox" TextChanged="SettingsChanged"/>
                        <TextBlock Text="OAuth Token"/><TextBox x:Name="FlickrTokenBox" TextChanged="SettingsChanged"/><TextBlock Text="OAuth Token Secret"/><TextBox x:Name="FlickrTokenSecretBox" TextChanged="SettingsChanged"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>

            <!-- SETTINGS: Android stacked cards -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Camera" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="SettingsCameraName" Text="Nikon Z8" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SettingsCameraMode" Text="Direct Wi-Fi FTP" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
                        <UniformGrid Columns="2"><Button Content="CHOOSE CAMERA" Background="{StaticResource Blue}" Click="ChooseCamera_Click"/><Button Content="CAMERA SETUP" Background="#2E7D32" Click="CameraSetup_Click"/></UniformGrid>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Connection Methods" FontSize="18" FontWeight="Bold"/>
                        <Button Content="USB-C WIRED / TETHER" Background="{StaticResource Green}" Click="UsbTether_Click"/>
                        <Button Content="WI-FI / HOTSPOT FTP" Background="{StaticResource Blue}" Click="CameraSetup_Click"/>
                        <Button Content="WINDOWS HOTSPOT" Background="#6A4C93" Click="Hotspot_Click"/>
                        <Button Content="ADVANCED CAMERA / FTP" Click="AdvancedCamera_Click"/>
                        <TextBlock x:Name="SettingsConnectionText" Text="Connection status" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Automatic editor workflow" FontSize="18" FontWeight="Bold"/>
                        <CheckBox x:Name="AutoProcessCheck" Content="Automatically process new JPEGs through the locked editor layout" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Upload result" Foreground="{StaticResource Muted}" Margin="5,4,0,0"/>
                        <ComboBox x:Name="UploadChoiceCombo" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Original only" Tag="OriginalOnly"/><ComboBoxItem Content="Edited/card only" Tag="EditedOnly" IsSelected="True"/><ComboBoxItem Content="Both original + edited" Tag="Both"/></ComboBox>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Output Folder" FontSize="18" FontWeight="Bold"/><TextBox x:Name="OutputRootBox" TextChanged="SettingsChanged"/><Button Content="CHOOSE OUTPUT FOLDER" Click="ChooseOutput_Click"/><TextBlock Text="Originals stay untouched. Edited copies are stored separately." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>

            <!-- ADVANCED CAMERA / FTP -->
            <Grid x:Name="CameraPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,4,0,8">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="WI-FI / FTP RECEIVER" FontWeight="Bold" FontSize="18"/><TextBlock Text="Plain FTP • port 2121 • passive/PASV • JPEG for the automatic Flickr workflow." TextWrapping="Wrap" Foreground="#B7C3CC" Margin="0,5,0,8"/>
                        <UniformGrid Columns="3"><StackPanel><TextBlock Text="Port" Margin="4"/><TextBox x:Name="FtpPortBox" Text="2121"/></StackPanel><StackPanel><TextBlock Text="User" Margin="4"/><TextBox x:Name="FtpUserBox" Text="nikon"/></StackPanel><StackPanel><TextBlock Text="Password" Margin="4"/><TextBox x:Name="FtpPasswordBox" Text="nikon"/></StackPanel></UniformGrid>
                        <Button x:Name="FtpStartButton" Content="START FTP RECEIVER" Background="#2E7D32" Click="FtpStart_Click"/><Button Content="STOP FTP" Click="FtpStop_Click"/><Button Content="OPEN WINDOWS HOTSPOT" Background="{StaticResource Blue}" Click="Hotspot_Click"/>
                        <TextBlock x:Name="FtpStatusText" Text="FTP stopped" Foreground="{StaticResource Amber}" Margin="4"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="USB / TETHER FOLDER" FontWeight="Bold" FontSize="18"/><TextBlock Text="Choose the capture folder used by Nikon NX Tether, Canon EOS Utility, Sony/Fujifilm tether software, or scan a mounted camera/DCIM drive." TextWrapping="Wrap" Foreground="#B7C3CC" Margin="0,5,0,8"/>
                        <TextBox x:Name="WatchFolderBox"/><Button Content="CHOOSE TETHER FOLDER" Background="{StaticResource Blue}" Click="ChooseWatchFolder_Click"/><Button Content="START WATCHING" Background="#2E7D32" Click="StartWatch_Click"/><Button Content="SCAN CAMERA / DCIM" Background="#6A4C93" Click="ScanCamera_Click"/><TextBlock x:Name="WatchStatusText" Text="No tether folder selected" Foreground="{StaticResource Amber}" Margin="4"/>
                    </StackPanel></Border>
                    <Button Content="‹  BACK TO SETTINGS" HorizontalAlignment="Stretch" Click="Settings_Click"/>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>

        <!-- Android bottom navigation -->
        <Border Grid.Row="2" Background="#090E13" BorderBrush="#26323D" BorderThickness="1" CornerRadius="18" Padding="4" Margin="0,5,0,0">
            <UniformGrid Columns="5">
                <Button Style="{StaticResource NavButton}" Content="⌂&#x0a;Home" Click="Home_Click"/>
                <Button Style="{StaticResource NavButton}" Content="▣&#x0a;Photos" Click="Photos_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⇧&#x0a;Uploads" Click="Uploads_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⚙&#x0a;Settings" Click="Settings_Click"/>
                <Button Style="{StaticResource NavButton}" Content="✎&#x0a;Editor" Click="Editor_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>