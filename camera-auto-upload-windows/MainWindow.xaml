<Window x:Class="CameraAutoUpload.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Auto Upload" Width="1280" Height="920" MinWidth="980" MinHeight="700"
        Background="#070B0F" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#26323D"/>
            <Setter Property="BorderBrush" Value="#43515F"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#17202A"/><Setter Property="BorderBrush" Value="#43515F"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="7"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#17202A"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#10171F"/><Setter Property="BorderBrush" Value="#2A3642"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="4,6"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#090E13"/><Setter Property="BorderBrush" Value="#1E2933"/><Setter Property="Height" Value="62"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="2"/></Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="86"/><Setter Property="Height" Value="48"/><Setter Property="FontWeight" Value="Bold"/></Style>
    </Window.Resources>

    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" Background="#17202A" CornerRadius="12" VerticalAlignment="Center"><TextBlock Text="📷" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Camera Auto Upload" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
            <Button Grid.Column="2" Content="⚙" FontSize="20" Padding="0" Click="Settings_Click" ToolTip="Settings"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- HOME -->
            <Grid x:Name="HomePage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1050" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Card}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="📷" FontSize="86" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HomeCameraName" Text="Nikon Z8" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HomeCameraMode" Text="Direct Wi-Fi FTP" Foreground="#A0AAB5" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="CHOOSE CAMERA" Background="#1976D2" Click="ChooseCamera_Click"/>
                                    <Button Content="CAMERA SETUP" Background="#2E7D32" Click="CameraSetup_Click"/>
                                </WrapPanel>
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <Border Background="#17202A" CornerRadius="10" Margin="3" Padding="10"><StackPanel><TextBlock Text="CAMERA INPUT" Foreground="#2196F3" FontWeight="Bold"/><TextBlock x:Name="HomeCameraStatus" Text="Not running" TextWrapping="Wrap" FontSize="16" Margin="0,5,0,0"/></StackPanel></Border>
                                    <Border Background="#17202A" CornerRadius="10" Margin="3" Padding="10"><StackPanel><TextBlock Text="LOCKED LAYOUT" Foreground="#FFC107" FontWeight="Bold"/><TextBlock x:Name="HomeLockStatus" Text="Off" FontSize="16" Margin="0,5,0,0"/></StackPanel></Border>
                                    <Border Background="#17202A" CornerRadius="10" Margin="3" Padding="10"><StackPanel><TextBlock Text="FLICKR QUEUE" Foreground="#55CE6C" FontWeight="Bold"/><TextBlock x:Name="HomeQueueStatus" Text="0 pending" FontSize="16" Margin="0,5,0,0"/></StackPanel></Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CONNECTION STATUS" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="ConnectionSummary" Text="Waiting for camera" Foreground="#C7D0D8" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                <WrapPanel>
                                    <Button Content="START FTP RECEIVER" Background="#2E7D32" Click="FtpStart_Click"/>
                                    <Button Content="USB / TETHER" Background="#1976D2" Click="UsbTether_Click"/>
                                    <Button Content="WINDOWS HOTSPOT" Background="#6A4C93" Click="Hotspot_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="EDITOR AUTOMATION" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="EditorAutomationText" Text="Open Editor, build the layout, then LOCK it for incoming camera photos." Foreground="#A0AAB5" TextWrapping="Wrap" Margin="0,7,0,8"/>
                                <Button Content="OPEN PHOTO EDITOR" Background="#1976D2" HorizontalAlignment="Left" Click="Editor_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="ACTIVITY" FontSize="17" FontWeight="Bold"/><TextBox x:Name="ActivityLog" Height="180" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- PHOTOS -->
            <Grid x:Name="PhotosPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="4,0,4,8">
                    <Button Content="ALL" Click="PhotosAll_Click"/><Button Content="ORIGINALS" Click="PhotosOriginals_Click"/><Button Content="EDITED" Click="PhotosEdited_Click"/><Button Content="INBOUND" Click="PhotosInbound_Click"/>
                    <Button Content="REFRESH" Background="#1976D2" Click="RefreshPhotos_Click"/><Button Content="OPEN PHOTO FOLDER" Background="#2E7D32" Click="OpenPhotosFolder_Click"/>
                </WrapPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel><TextBlock x:Name="PhotosFolderText" DockPanel.Dock="Top" Text="Photos" Foreground="#91A3B4" Margin="0,0,0,8"/><ListBox x:Name="PhotosList" Background="#0B1016" Foreground="White" BorderBrush="#33414E" FontSize="14" MouseDoubleClick="PhotosList_DoubleClick"/></DockPanel>
                </Border>
            </Grid>

            <!-- EDITOR -->
            <Grid x:Name="EditorPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="60"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Photo Editor" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Grid.Column="1" x:Name="LockLayoutButton" Content="LOCK" Background="#B43A38" MinWidth="86" Click="LockLayout_Click"/>
                    <Button Grid.Column="2" Content="SAVE" Background="#EF5350" MinWidth="76" Click="SaveLayout_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="EditorStatus" Text="Tap/click photo, text, number, logo or frame directly • drag • wheel/pinch • rotate • double-click for properties" Foreground="#A0AAB5" FontSize="12" Margin="8,0" TextWrapping="Wrap"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#090C11" BorderBrush="#34424F" BorderThickness="1" CornerRadius="8" Margin="4" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Viewbox x:Name="EditorViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas x:Name="Artboard" Width="1080" Height="1350" Background="#1D2630" MouseDown="Artboard_MouseDown" MouseMove="Artboard_MouseMove" MouseUp="Artboard_MouseUp" MouseWheel="Artboard_MouseWheel" IsManipulationEnabled="True" ManipulationDelta="Artboard_ManipulationDelta"/>
                            </Viewbox>
                        </ScrollViewer>
                    </Border>
                    <Border x:Name="LayersPanel" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="LAYERS" FontWeight="Bold" FontSize="17"/><TextBlock Text="Double-click text/image/photo for properties." Foreground="#91A3B4" TextWrapping="Wrap" Margin="0,4,0,8"/></StackPanel><ListBox x:Name="LayerList" Background="#0F151C" Foreground="White" BorderBrush="#33414E" SelectionChanged="LayerList_SelectionChanged"/></DockPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Button Style="{StaticResource ToolButton}" Content="PHOTO" Background="#2196F3" Click="OpenPhoto_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="FRAME" Background="#37CE6C" Click="AddImage_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="TEXT" Background="#2196F3" Click="AddText_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="NAME" Background="#2196F3" Click="AddName_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="#" Background="#2196F3" Click="AddNumber_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="POSITION" Background="#2196F3" Click="AddPosition_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="LOGO" Background="#37CE6C" Click="AddImage_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="SHAPE" Background="#6A4C93" Click="AddShape_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="COLOR" Background="#6A4C93" Click="Color_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="PROPERTIES" Background="#4B5A7D" Click="Properties_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="LAYERS" Click="Layers_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Button Style="{StaticResource ToolButton}" Content="UNDO" Click="Undo_Click"/><Button Style="{StaticResource ToolButton}" Content="REDO" Click="Redo_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="FIT PHOTO" Click="FitPhoto_Click"/><Button Style="{StaticResource ToolButton}" Content="FIT VIEW" Click="FitView_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="FRONT" Click="BringFront_Click"/><Button Style="{StaticResource ToolButton}" Content="BACK" Click="SendBack_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="COPY" Click="Duplicate_Click"/><Button Style="{StaticResource ToolButton}" Content="DELETE" Background="#B43A38" Click="Delete_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="CROP" Background="#8A6D00" Click="Crop_Click"/><Button Style="{StaticResource ToolButton}" Content="RESET CROP" Click="ResetCrop_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="GRID" Click="Grid_Click"/><Button Style="{StaticResource ToolButton}" Content="EXPORT" Background="#6A4C93" Click="Export_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- UPLOADS -->
            <Grid x:Name="UploadsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Flickr Uploads" FontSize="24" FontWeight="Bold"/><CheckBox x:Name="FlickrEnabledCheck" Content="Upload new photos to Flickr" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="Flickr API Key"/><TextBox x:Name="FlickrApiKeyBox" TextChanged="SettingsChanged"/><TextBlock Text="Flickr API Secret"/><TextBox x:Name="FlickrApiSecretBox" TextChanged="SettingsChanged"/>
                        <TextBlock Text="OAuth Token"/><TextBox x:Name="FlickrTokenBox" TextChanged="SettingsChanged"/><TextBlock Text="OAuth Token Secret"/><TextBox x:Name="FlickrTokenSecretBox" TextChanged="SettingsChanged"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="QUEUE" FontWeight="Bold" FontSize="17"/><TextBlock x:Name="QueueCountText" Text="0 pending" FontSize="26" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>

            <!-- SETTINGS -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="950" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Camera" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SettingsCameraName" Text="Nikon Z8" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SettingsCameraMode" Text="Direct Wi-Fi FTP" Foreground="#91A3B4" Margin="0,3,0,8"/>
                        <WrapPanel><Button Content="CHOOSE CAMERA" Background="#1976D2" Click="ChooseCamera_Click"/><Button Content="CAMERA SETUP" Background="#2E7D32" Click="CameraSetup_Click"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Connection Methods" FontSize="20" FontWeight="Bold"/>
                        <WrapPanel Margin="0,8,0,0"><Button Content="USB-C / TETHER" Background="#37CE6C" Click="UsbTether_Click"/><Button Content="WI-FI / HOTSPOT" Background="#1976D2" Click="CameraSetup_Click"/><Button Content="WINDOWS HOTSPOT" Background="#6A4C93" Click="Hotspot_Click"/><Button Content="ADVANCED CAMERA / FTP" Click="AdvancedCamera_Click"/></WrapPanel>
                        <TextBlock x:Name="SettingsConnectionText" Text="Connection status" Foreground="#A0AAB5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Automatic editor workflow" FontSize="20" FontWeight="Bold"/><CheckBox x:Name="AutoProcessCheck" Content="Automatically process new JPEGs through the locked editor layout" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <ComboBox x:Name="UploadChoiceCombo" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Original only" Tag="OriginalOnly"/><ComboBoxItem Content="Edited/card only" Tag="EditedOnly" IsSelected="True"/><ComboBoxItem Content="Both original + edited" Tag="Both"/></ComboBox>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Output Folder" FontSize="20" FontWeight="Bold"/><TextBox x:Name="OutputRootBox" TextChanged="SettingsChanged"/><Button Content="CHOOSE OUTPUT FOLDER" HorizontalAlignment="Left" Click="ChooseOutput_Click"/><TextBlock Text="Originals stay untouched. Edited copies are stored separately." Foreground="#91A3B4"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>

            <!-- ADVANCED CAMERA / FTP -->
            <Grid x:Name="CameraPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="950" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="WI-FI / FTP RECEIVER" FontWeight="Bold" FontSize="20"/><TextBlock Text="Use the same server settings shown in the Android app: plain FTP, port 2121, passive mode, and JPEG for the automatic Flickr workflow." TextWrapping="Wrap" Foreground="#B7C3CC" Margin="0,5,0,8"/>
                        <WrapPanel><TextBlock Text="Port" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="FtpPortBox" Width="90" Text="2121"/><TextBlock Text="User" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="FtpUserBox" Width="130" Text="nikon"/><TextBlock Text="Password" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="FtpPasswordBox" Width="160" Text="nikon"/></WrapPanel>
                        <WrapPanel><Button x:Name="FtpStartButton" Content="START FTP RECEIVER" Background="#2E7D32" Click="FtpStart_Click"/><Button Content="STOP FTP" Click="FtpStop_Click"/><Button Content="OPEN WINDOWS HOTSPOT" Background="#1976D2" Click="Hotspot_Click"/></WrapPanel>
                        <TextBlock x:Name="FtpStatusText" Text="FTP stopped" Foreground="#FFC107" Margin="4"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="USB / TETHER FOLDER" FontWeight="Bold" FontSize="20"/><TextBlock Text="Use Nikon NX Tether, Canon EOS Utility, Sony tether software, Fujifilm tether software, or another camera capture folder. New files are detected automatically." TextWrapping="Wrap" Foreground="#B7C3CC" Margin="0,5,0,8"/>
                        <TextBox x:Name="WatchFolderBox"/><WrapPanel><Button Content="CHOOSE TETHER FOLDER" Background="#1976D2" Click="ChooseWatchFolder_Click"/><Button Content="START WATCHING" Background="#2E7D32" Click="StartWatch_Click"/><Button Content="SCAN CAMERA / DCIM" Background="#6A4C93" Click="ScanCamera_Click"/></WrapPanel><TextBlock x:Name="WatchStatusText" Text="No tether folder selected" Foreground="#FFC107" Margin="4"/>
                    </StackPanel></Border>
                    <Button Content="BACK TO SETTINGS" HorizontalAlignment="Left" Click="Settings_Click"/>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>

        <!-- Android-style bottom nav -->
        <Border Grid.Row="2" Background="#090E13" BorderBrush="#26323D" BorderThickness="1" CornerRadius="16" Padding="4">
            <UniformGrid Columns="5">
                <Button Style="{StaticResource NavButton}" Content="⌂&#x0a;Home" Click="Home_Click"/>
                <Button Style="{StaticResource NavButton}" Content="▣&#x0a;Photos" Click="Photos_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⇧&#x0a;Uploads" Click="Uploads_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⚙&#x0a;Settings" Click="Settings_Click"/>
                <Button Style="{StaticResource NavButton}" Content="✎&#x0a;Editor" Click="Editor_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
